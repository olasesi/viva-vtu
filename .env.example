# ╔══════════════════════════════════════════════════════════════════╗
# ║                    VIVA VTU — Environment Config               ║
# ╚══════════════════════════════════════════════════════════════════╝

# ─── General ──────────────────────────────────────────────────────
NODE_ENV=development
APP_ENV=local
APP_DEBUG=true

# ─── Database (MySQL) ────────────────────────────────────────────
DB_ROOT_PASSWORD=secret
DB_DATABASE=viva_vtu
DB_USERNAME=viva
DB_PASSWORD=secret

# ─── Redis ───────────────────────────────────────────────────────
REDIS_PASSWORD=secret

# ─── JWT (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))") ──
JWT_SECRET=change-me-to-random-64-char-string
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# ─── Auth Service ────────────────────────────────────────────────
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USER=
MAIL_PASS=
MAIL_FROM=noreply@vivavtu.com
FRONTEND_URL=http://localhost:3002

# ─── Laravel Billing Service ─────────────────────────────────────
APP_KEY=
APP_URL=http://localhost:8000

# ─── VTPass API (https://vtpass.com) ────────────────────────────
VTTPASS_API_KEY=
VTTPASS_SECRET_KEY=
VTTPASS_USERNAME=
VTTPASS_PASSWORD=
VTTPASS_BASE_URL=https://vtpass.com/api

# ─── Paystack (https://paystack.com) ────────────────────────────
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# ─── Flutterwave (https://flutterwave.com) ──────────────────────
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=

# ─── Django Analytics Service ────────────────────────────────────
DJANGO_SECRET_KEY=change-me-in-production
DEBUG=True
SENTRY_DSN=
INTERNAL_API_KEY=viva-internal-secret

# ─── Frontend (Next.js — uses NEXT_PUBLIC_ prefix) ──────────────
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_PAYSTACK_KEY=pk_test_...
NEXT_PUBLIC_FLUTTERWAVE_KEY=FLWSECK_TEST-...

# ─── CORS ────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3002
